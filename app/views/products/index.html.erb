<section class="hero is-warning is-small mb-5">
  <div class="hero-body">
    <div class="container">
      <h1 class="title is-3">🚀 地球救済ミッション発動中！</h1>
      <p class="subtitle is-6">
        リストから<strong>[★]がついた3つの神器</strong>をカートに入れて決済すると世界が救われます。<br>
        合言葉は「Railsで世界を救うニャ！」です。
      </p>
    </div>
  </div>
</section>

<div class="container pb-6">
  <div class="columns is-multiline">
    <% @products.each do |product| %>
      <div class="column is-4">
        <div class="card">
          <div class="card-image">
            <%= link_to product do %>
              <figure class="image is-1by1">
                <%= product_image_tag product %>
              </figure>
            <% end %>
          </div>
          <div class="card-content">
            <div class="media">
              <div class="media-content">
                <p class="title is-5"><%= product.name %></p>
                <p class="subtitle is-6">¥<%= number_with_delimiter(product.price) %></p>
              </div>
            </div>
            <div class="content">
              <%= product.description %>
            </div>
            <%= button_to "カートに入れるニャ！", add_item_cart_path(product_id: product.id), method: :post, class: "button is-warning is-fullwidth" %>
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <div class="has-text-centered mt-5">
    <%= link_to "現在のカートを見る", cart_path, class: "button is-info is-large" %>
  </div>
</div>
