<div id="<%= dom_id product %>" class="box">
  <figure class="image product-show-image mb-4">
    <%= product_image_tag product %>
  </figure>

  <p class="title is-3"><%= product.name %></p>
  <p class="subtitle is-5">¥<%= number_with_delimiter(product.price) %></p>
  <div class="content">
    <%= product.description %>
  </div>
</div>
